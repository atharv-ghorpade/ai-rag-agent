# Hugging Face Cache Directory (defaults to D:/huggingface_cache as in original notebook)
HF_HOME=D:/huggingface_cache
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Models (Lightweight Setup: ~220 MB total)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Qdrant Vector Database
# Mode options:
#   'local'  - Embedded file-based storage (works out-of-the-box, no server/docker needed)
#   'server' - Connect to running Qdrant daemon (e.g., http://localhost:6333)
#   'memory' - In-memory database (great for quick testing/ephemeral runs)
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_STORAGE_PATH=./data/qdrant_storage
COLLECTION_NAME=enterprise_documents
VECTOR_SIZE=384
